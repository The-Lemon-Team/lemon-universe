{
  "name": "lemon-universe",
  "version": "0.2.0",
  "description": "Lemon Universe — TimeLines, Neuron Arena & Party Games suite for collective decision making and coding sessions",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "api:install": "npm --prefix server install",
    "api:build": "npm --prefix server run build",
    "api:start": "npm --prefix server run start:prod",
    "api:dev": "npm --prefix server run start:dev",
    "api:test": "npm --prefix server test",
    "mcp:stdio": "npm --prefix server run mcp:stdio",
    "mcp:inspect": "npm --prefix server run mcp:inspect"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.14",
    "@lemon/themes": "file:../lemon-themes",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.6.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.2"
  }
}
